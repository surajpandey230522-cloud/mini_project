# ==============================================================================
# AKTU Notes AI — Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME=AKTU Notes AI
APP_ENV=production
DEBUG=false
PORT=8000

# ------------------------------------------------------------------------------
# Database: NeonDB (Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Paste your Neon connection string directly from the Neon Console:
# Example: postgresql+psycopg://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Note: The backend automatically converts "postgres://" or "postgresql://" to "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key (e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ------------------------------------------------------------------------------
# Google Gemini AI (RAG Inference & Embeddings)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourActualGoogleGeminiApiKey
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# Storage & Vector Persistence
# ------------------------------------------------------------------------------
# On Render with a persistent disk, use: /var/data/chroma and /var/data/uploads
CHROMA_PERSIST_DIR=./storage/chroma
UPLOAD_DIR=./storage/uploads

# ------------------------------------------------------------------------------
# PDF Constraints & RAG Pipeline Tuning
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=300
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=3

# ------------------------------------------------------------------------------
# CORS: Allow All Origins (Vercel, Localhost, Mobile, Any Origin)
# ------------------------------------------------------------------------------
CORS_ORIGIN_ALL=true
CORS_ORIGINS=*
CORS_ALLOW_ORIGIN_REGEX=

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_CHAT=30/minute
